# Server
PORT=4000
NODE_ENV=development

# MongoDB (supports MONODB_URI for backward compatibility)
MONGODB_URI=

# JWT — use SECRET_JWT_CODE or SECRET (both are supported)
SECRET_JWT_CODE=
SECRET=

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
DOMAIN_NAME=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Chapa payments
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
